DATABASE_URL=postgres://savez:savez@localhost:5433/savez
JWT_KEY=dev-only-placeholder-change-me
OFFICIAL_API_URL=https://api.shapez.io
PORT=15001
# Authentication mode (phase 2 switch, ROADMAP SC4): oracle | open | steam-openid
# Defaults to "oracle" if unset. Only "oracle" is functional in v1 — "open" and
# "steam-openid" are declared here but not yet wired up (deferred to phase 2,
# activated once api.shapez.io closes).
AUTH_MODE=oracle
# Listen address (Phase 8, ADR 0009). Defaults to "127.0.0.1" if unset — matches the historical
# bare-metal/dev contract of a purely local listener. The production stack (deploy/) sets
# "0.0.0.0" so the sibling `caddy` container can reach `app:15001`; the port is never published
# to the host regardless of this value (deploy/docker-compose.yml has no `ports:` on `app`).
BIND_ADDR=127.0.0.1
