# ---------------------------------------------------------------------------
# AVERTISSEMENT : CE FICHIER EST INTENTIONNELLEMENT VERSIONNÉ ET SES VALEURS
# SONT PUBLIQUES PAR CONSTRUCTION. AUCUNE DE CES VALEURS N'EST UN SECRET RÉEL
# -- NE JAMAIS LES RÉUTILISER AILLEURS QU'EN SMOKE TEST LOCAL ÉPHÉMÈRE.
# Ce fichier n'est JAMAIS déployé sur un VPS ; il alimente uniquement
# deploy/docker-compose.smoketest.yml pour un smoke test local reproductible
# sans création manuelle de deploy/.env. Nommé `smoketest.env` (et non
# `.env.smoketest`) car .gitignore exclut `.env.*` et ne ré-inclut que
# `!.env.example` -- ce nom n'est jamais capté par ce motif.
# ---------------------------------------------------------------------------

DATABASE_URL=postgres://savez:smoketest-only@db:5432/savez
JWT_KEY=smoketest-only-not-a-real-key
OFFICIAL_API_URL=https://api.shapez.io
PORT=15001
AUTH_MODE=oracle

DOMAIN=localhost
SAVEZ_VERSION=latest

POSTGRES_USER=savez
POSTGRES_PASSWORD=smoketest-only
POSTGRES_DB=savez

BIND_ADDR=0.0.0.0
RUST_LOG=info

# rclone / S3-compatible endpoint, servi localement par le service `minio`
# du recouvrement de smoke test (deploy/docker-compose.smoketest.yml).
RCLONE_REMOTE=backup
RCLONE_BUCKET=savez-smoketest
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Minio
RCLONE_CONFIG_BACKUP_ENDPOINT=http://localhost:9000
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=savezsmoke
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=savezsmoke123

# Lues directement par le service `minio` du recouvrement de smoke test.
MINIO_ROOT_USER=savezsmoke
MINIO_ROOT_PASSWORD=savezsmoke123
