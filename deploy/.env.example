# ---------------------------------------------------------------------------
# Squelette de production -- à copier vers deploy/.env sur le VPS et à
# compléter. Toute valeur secrète ici est vide ou un placeholder explicite ;
# aucune valeur réelle ne doit jamais entrer dans ce fichier versionné.
# ---------------------------------------------------------------------------

# Variables lues par Config::from_env() (src/config.rs) -- reprises de
# .env.example (racine), adaptées au réseau Compose de production : `db` est
# le nom du service PostgreSQL sibling, port interne 5432 (jamais
# localhost:5433, qui est le remappage dev lié à un conflit de port Windows).
#
# IMPORTANT : le mot de passe ici DOIT être identique à POSTGRES_PASSWORD
# ci-dessous -- une valeur différente fait échouer l'authentification de
# `app` contre `db` au démarrage.
DATABASE_URL=postgres://savez:CHANGEME@db:5432/savez
JWT_KEY=
OFFICIAL_API_URL=https://api.shapez.io
PORT=15001
# Authentication mode (phase 2 switch, ROADMAP SC4): oracle | open | steam-openid
# Defaults to "oracle" if unset. Only "oracle" is functional in v1 — "open" and
# "steam-openid" are declared here but not yet wired up (deferred to phase 2,
# activated once api.shapez.io closes).
AUTH_MODE=oracle

# ---------------------------------------------------------------------------
# Domaine (deploy/Caddyfile) -- D-05 : aucun nom de domaine réel n'est choisi
# à ce stade. Ce placeholder générique permet à l'achat futur d'un vrai
# domaine de ne modifier QUE cette valeur, jamais le Caddyfile versionné.
# ---------------------------------------------------------------------------
DOMAIN=votre-domaine.example

# ---------------------------------------------------------------------------
# Image applicative (deploy/docker-compose.yml) -- tag publié par
# .github/workflows/release.yml sur chaque push de tag v*.
# ---------------------------------------------------------------------------
SAVEZ_VERSION=latest

# ---------------------------------------------------------------------------
# PostgreSQL (service `db`) -- mêmes noms de clés qu'en dev/CI, valeurs à
# renseigner sur le VPS. POSTGRES_PASSWORD doit être identique au mot de
# passe encodé dans DATABASE_URL ci-dessus.
# ---------------------------------------------------------------------------
POSTGRES_USER=savez
POSTGRES_PASSWORD=
POSTGRES_DB=savez

# ---------------------------------------------------------------------------
# Réseau conteneur (ADR 0009, plan 08-01) -- 0.0.0.0 est OBLIGATOIRE dans le
# conteneur `app` : le défaut loopback (127.0.0.1) rendrait l'application
# injoignable depuis le conteneur `caddy` sibling (reverse_proxy app:15001
# échouerait en connexion refusée). Voir docs/adr/0009-bind-address-configurable.md.
# ---------------------------------------------------------------------------
BIND_ADDR=0.0.0.0

# ---------------------------------------------------------------------------
# Journalisation -- OBLIGATOIRE en production : sans RUST_LOG, le filtre par
# défaut de tracing_subscriber::fmt::init() est "error", donc les lignes
# tracing::info!("listening") et tracing::info!("migrations applied") ne
# s'affichent PAS et le journal de production reste muet.
# ---------------------------------------------------------------------------
RUST_LOG=info

# ---------------------------------------------------------------------------
# Sauvegarde (deploy/backup.sh, plan 08-03) -- remote rclone nommé "backup" ;
# rclone met le nom du remote en MAJUSCULES dans les variables
# RCLONE_CONFIG_BACKUP_*. Aucun fournisseur S3 n'est codé en dur :
# PROVIDER=Other est le réglage générique compatible avec tout endpoint
# S3-compatible (D-06).
# ---------------------------------------------------------------------------
RCLONE_REMOTE=backup
RCLONE_BUCKET=
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Other
RCLONE_CONFIG_BACKUP_ENDPOINT=
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=
