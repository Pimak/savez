{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT l.id, u.name AS moderator_name, l.action, l.target_type, l.target_id, l.details,\n               l.created_at\n        FROM moderation_log l\n        JOIN users u ON u.id = l.moderator_id\n        ORDER BY l.created_at DESC, l.id DESC\n        LIMIT $1 OFFSET $2\n        ",
